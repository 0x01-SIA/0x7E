[Unit]
Description=0x7E captive portal chat
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/0x7E
ExecStart=/bin/sh -c 'if [ -x .venv/bin/python ]; then exec .venv/bin/python portal/app.py; else exec python3 portal/app.py; fi'
Restart=on-failure
RestartSec=3
Environment=PORTAL_PORT=8080

[Install]
WantedBy=multi-user.target
